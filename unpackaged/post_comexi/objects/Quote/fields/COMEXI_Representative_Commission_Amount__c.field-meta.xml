<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>COMEXI_Representative_Commission_Amount__c</fullName>
    <description>Importe de comisión del representante que se lleva esta oferta. Calculado sobre el total de la oferta, es el dato que hoy se recalcula a mano cada vez que cambia el descuento.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(COMEXI_Representative_Commission_Pct__c), 0, TotalPrice * COMEXI_Representative_Commission_Pct__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Importe de comisión del representante (calculado).</inlineHelpText>
    <label>Comisión representante</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
