<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>COMEXI_Down_Payment_Amount__c</fullName>
    <description>Importe del anticipo calculado sobre el total del pedido. Es la cifra que hay que ver cobrada antes de que arranque ingenieria.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(COMEXI_Down_Payment_Pct__c), 0, TotalAmount * COMEXI_Down_Payment_Pct__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Importe del anticipo (calculado).</inlineHelpText>
    <label>Anticipo (importe)</label>
    <required>false</required>
    <precision>18</precision>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
