<?xml version="1.0" encoding="UTF-8"?>
<!--
  Profile parcial: solo asigna los page layouts de Opportunity por record type.
  Un deploy de Profile solo toca lo declarado, asi que esto no altera el resto del
  perfil Admin. La pagina que realmente se renderiza en Lightning es la flexipage
  COMEXI_Opportunity_Retrofit_Record_Page (via el actionOverride de la app); el
  layout gobierna las related lists y el fallback, y mantiene los campos COMEXI en
  la maqueta del record type Retrofitting.
-->
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutAssignments>
        <layout>Opportunity-RLM Opportunity Layout</layout>
    </layoutAssignments>
    <layoutAssignments>
        <layout>Opportunity-COMEXI Retrofit Layout</layout>
        <recordType>Opportunity.COMEXI_Retrofitting</recordType>
    </layoutAssignments>
    <layoutAssignments>
        <layout>Opportunity-RLM Opportunity Layout</layout>
        <recordType>Opportunity.COMEXI_Comercial</recordType>
    </layoutAssignments>
    <layoutAssignments>
        <layout>Opportunity-RLM Opportunity Layout</layout>
        <recordType>Opportunity.COMEXI_Servicio</recordType>
    </layoutAssignments>
</Profile>
